# Copy to .env. Every value has a default in docker-compose.yml, but the gateway broker
# (docker compose --profile broker up) needs MQTT_USER, MQTT_PASS and GATEWAY_PSK.

# Broker URL: mqtt://host:1883, or mqtts://host:8883 for TLS (checked against the system CAs).
# The default is the local test broker: docker compose --profile lab up
# With the gateway broker: mqtt://broker:1883
MQTT_URL=mqtt://mosquitto:1883
# Broker login. The gateway broker creates it, for the bridge and the gateways.
MQTT_USER=
MQTT_PASS=
# Empty = random client ID
MQTT_CLIENT_ID=
# Topic of your Wittra MQTT publication, or onprem/# for gateways (see README, "Gateways")
MQTT_TOPIC=onprem/#
# Message types to expose over OPC UA: comma-separated, a trailing * matches a prefix.
# Empty = all. Each exposed field is one OPC UA variable, e.g.
# OPCUA_SENSORS=LAN-MIOTY-*,wittra-tag-battery
OPCUA_SENSORS=

# Host name clients use to reach this machine. It goes into the OPC UA endpoint URL and the
# server certificate, which is created on the first start (see README to change it later).
OPCUA_HOSTNAME=wittra-opcua
# OPC UA users (see users.example.json). Keep the file out of git.
USERS_FILE=./users.json

# Gateway broker only: the gateways' pre-shared key, in hex. Create one: openssl rand -hex 32
GATEWAY_PSK=
